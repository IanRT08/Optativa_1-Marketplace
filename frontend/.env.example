# Copia este archivo como .env (en esta misma carpeta) y llena los valores.
# .env está en .gitignore: nunca se sube a Git.

# URL base de API Gateway, sin "/" al final (https obligatorio)
API_BASE_URL=

# Clave para firmar la sesión y el CSRF; 32 caracteres o más. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opcional. Vacío en local: la sesión se guarda en archivos (frontend/flask_session/).
# En Vercel la pone Upstash al conectar la base de datos; debe empezar con rediss://
REDIS_URL=

# Opcional. Déjalo vacío (cookie Secure). Solo para pruebas locales en un
# navegador que rechace cookies Secure en http://localhost, pon: false
COOKIE_SECURE=
